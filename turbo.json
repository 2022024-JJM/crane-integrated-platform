{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.json",
    "tsconfig.base.json",
    "eslint.config.js",
    ".prettierrc",
    "turbo.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_API_BASE_URL",
        "VITE_WS_BASE_URL",
        "VITE_API_TIMEOUT_MS",
        "VITE_WS_RECONNECT_INTERVAL_MS",
        "VITE_WS_RECONNECT_INITIAL_MS",
        "VITE_WS_RECONNECT_MAX_MS",
        "VITE_WS_MAX_RECONNECT_ATTEMPTS",
        "VITE_BASE_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
