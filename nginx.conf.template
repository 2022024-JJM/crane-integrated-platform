# nginx 공식 이미지의 envsubst 가 컨테이너 시작 시 이 파일을 읽어
# ${VAR} 들을 환경변수로 치환한 뒤 /etc/nginx/conf.d/default.conf 로 출력한다.
# 따라서 운영 환경에서 IP/PORT 변경은 .env 만 수정 후 컨테이너 재시작이면 충분하다.

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;

    # Security headers
    add_header X-Frame-Options        "SAMEORIGIN"                   always;
    add_header X-Content-Type-Options "nosniff"                      always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        image/svg+xml
        font/woff
        font/woff2
        model/gltf-binary
        model/gltf+json
        application/octet-stream;

    # Health check endpoint
    location = /healthz {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # API proxy → backend server
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 앞단이 rewrite 없이 그대로 /crane_rnd/api/* 로 전달한 경우에도 안전하게 처리
    location /crane_rnd/api/ {
        rewrite ^/crane_rnd/api/(.*)$ /api/$1 break;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket proxy → backend server
    location /ws/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 rewrite 없이 그대로 /crane_rnd/ws/* 로 전달한 경우에도 안전하게 처리
    location /crane_rnd/ws/ {
        rewrite ^/crane_rnd/ws/(.*)$ /ws/$1 break;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # LiDAR WebSocket proxy → 별도 LiDAR 서버
    # 프론트는 동일 origin 의 /lidar 또는 /crane_rnd/lidar 로 ws 연결한다.
    # LiDAR 서버는 루트(/)에서 ws 핸드셰이크를 받으므로 / 로만 프록시한다.
    # 슬래시 유무 모두 받아야 하므로 정확 매칭(=) 과 prefix 매칭을 모두 둔다.
    location = /lidar {
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /lidar/ {
        rewrite ^/lidar/(.*)$ /$1 break;
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 그대로 /crane_rnd/lidar(/) 로 전달한 경우 호환
    location = /crane_rnd/lidar {
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /crane_rnd/lidar/ {
        rewrite ^/crane_rnd/lidar/(.*)$ /$1 break;
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Cabin Monitoring Foxglove bridge WebSocket proxy → 별도 브리지 서버
    # 프론트는 동일 origin 의 /cabin-bridge 또는 /crane_rnd/cabin-bridge 로 ws 연결한다.
    # 브리지 서버는 루트(/)에서 ws 핸드셰이크를 받으므로 / 로만 프록시한다.
    location = /cabin-bridge {
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /cabin-bridge/ {
        rewrite ^/cabin-bridge/(.*)$ /$1 break;
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 그대로 /crane_rnd/cabin-bridge(/) 로 전달한 경우 호환
    location = /crane_rnd/cabin-bridge {
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /crane_rnd/cabin-bridge/ {
        rewrite ^/crane_rnd/cabin-bridge/(.*)$ /$1 break;
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Root hit → redirect into the SPA base path
    location = / {
        return 302 /crane_rnd/;
    }

    # index.html — never cache
    location = /crane_rnd/index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
        try_files $uri =404;
    }

    # 빌드 산출물(dist/assets/)만 immutable. vite 가 내용 해시를 파일명에 넣으므로
    # 내용이 바뀌면 URL 도 바뀐다 → 영구 캐시가 안전하다.
    # (^~ 는 아래 정규식 location 보다 우선하므로 이 블록이 먼저 매칭된다.)
    location ^~ /crane_rnd/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # public/ 자산(models·maps·scenes·images·icons·drawings)은 해시 파일명이 아니다.
    # 여기에 immutable 을 걸면 GLB 를 교체 배포해도, 씬 배치를 수정해도 기존 방문자
    # 브라우저는 1년간 서버에 묻지 않고 옛 파일을 계속 쓴다(재검증조차 하지 않음).
    # ETag/Last-Modified 재검증으로 둔다 — 변경이 없으면 304 만 오가므로 본문 전송은 없다.
    location ~* ^/crane_rnd/.+\.(?:js|css|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|gif|webp|avif|glb|gltf|json)$ {
        expires off;
        add_header Cache-Control "public, no-cache" always;
        access_log off;
        try_files $uri =404;
    }

    # SPA entry: /crane_rnd and any deeper client-side route → serve index.html
    location /crane_rnd/ {
        try_files $uri $uri/ /crane_rnd/index.html;
    }

    # "/crane_rnd" (no trailing slash) → canonical form
    location = /crane_rnd {
        return 302 /crane_rnd/;
    }
}
