# nginx 공식 이미지의 envsubst 가 컨테이너 시작 시 이 파일을 읽어
# ${VAR} 들을 환경변수로 치환한 뒤 /etc/nginx/conf.d/default.conf 로 출력한다.
# 따라서 운영 환경에서 IP/PORT 변경은 .env 만 수정 후 컨테이너 재시작이면 충분하다.
#
# 앱 접두어는 ${BASE_PATH} 하나로 따라간다 (끝 슬래시 포함, 예: /crane_rnd/ · /crane_rnd/dev/).
# 값은 Dockerfile ARG → runner 의 ENV 로 이미지에 박히고, 끝 슬래시 없는 ${BASE_PATH_NOSLASH} 는
# deploy/nginx/15-base-path.envsh 가 치환 직전에 만든다. location 은 nginx 변수를 못 받으므로
# 경로는 반드시 이 템플릿 치환으로만 바꾼다. indoor 주소(VITE_INDOOR_BASE_URL)는 BASE_PATH 밖에
# 놓일 수 있어(dev · stage) 맨 아래 catch-all 이 같은 index.html 을 낸다.

# public/ 자산의 캐시 정책을 URL 의 `?v=` 유무로 가른다.
#
#   ?v=<내용해시> 가 있으면 → 내용이 바뀌면 URL 이 바뀐다 → immutable 안전.
#                             재검증 왕복조차 없으므로 25MB GLB 재방문이 즉시 뜬다.
#   ?v= 가 없으면          → URL 이 고정이다 → 반드시 매번 재검증(no-cache).
#                             직접 친 주소나 매니페스트에 없는 파일이 여기 온다.
#
# location 안의 `if` 로는 이걸 못 한다 — if 안의 add_header 는 바깥 것을
# 대체하지 않고 헤더를 하나 더 붙이기 때문이다. map 은 변수 하나로 값이
# 정해지므로 Cache-Control 이 정확히 한 번만 나간다.
map $arg_v $asset_cache_control {
    ""      "public, no-cache";
    default "public, max-age=31536000, immutable";
}

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;

    # Security headers
    add_header X-Frame-Options        "SAMEORIGIN"                   always;
    add_header X-Content-Type-Options "nosniff"                      always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        image/svg+xml
        font/woff
        font/woff2
        model/gltf-binary
        model/gltf+json
        application/octet-stream;

    # Health check endpoint
    location = /healthz {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # API proxy → backend server
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 앞단이 rewrite 없이 그대로 ${BASE_PATH}api/* 로 전달한 경우에도 안전하게 처리
    location ${BASE_PATH}api/ {
        rewrite ^${BASE_PATH}api/(.*)$ /api/$1 break;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket proxy → backend server
    location /ws/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 rewrite 없이 그대로 ${BASE_PATH}ws/* 로 전달한 경우에도 안전하게 처리
    location ${BASE_PATH}ws/ {
        rewrite ^${BASE_PATH}ws/(.*)$ /ws/$1 break;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # LiDAR WebSocket proxy → 별도 LiDAR 서버
    # 프론트는 동일 origin 의 /lidar 또는 ${BASE_PATH}lidar 로 ws 연결한다.
    # LiDAR 서버는 루트(/)에서 ws 핸드셰이크를 받으므로 / 로만 프록시한다.
    # 슬래시 유무 모두 받아야 하므로 정확 매칭(=) 과 prefix 매칭을 모두 둔다.
    location = /lidar {
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /lidar/ {
        rewrite ^/lidar/(.*)$ /$1 break;
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 그대로 ${BASE_PATH}lidar(/) 로 전달한 경우 호환
    location = ${BASE_PATH_NOSLASH}/lidar {
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location ${BASE_PATH}lidar/ {
        rewrite ^${BASE_PATH}lidar/(.*)$ /$1 break;
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Cabin Monitoring Foxglove bridge WebSocket proxy → 별도 브리지 서버
    # 프론트는 동일 origin 의 /cabin-bridge 또는 ${BASE_PATH}cabin-bridge 로 ws 연결한다.
    # 브리지 서버는 루트(/)에서 ws 핸드셰이크를 받으므로 / 로만 프록시한다.
    location = /cabin-bridge {
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /cabin-bridge/ {
        rewrite ^/cabin-bridge/(.*)$ /$1 break;
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 그대로 ${BASE_PATH}cabin-bridge(/) 로 전달한 경우 호환
    location = ${BASE_PATH_NOSLASH}/cabin-bridge {
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location ${BASE_PATH}cabin-bridge/ {
        rewrite ^${BASE_PATH}cabin-bridge/(.*)$ /$1 break;
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Root hit → redirect into the SPA base path
    location = / {
        return 302 ${BASE_PATH};
    }

    # index.html — never cache
    location = ${BASE_PATH}index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
        try_files $uri =404;
    }

    # 빌드 산출물(dist/assets/)만 immutable. vite 가 내용 해시를 파일명에 넣으므로
    # 내용이 바뀌면 URL 도 바뀐다 → 영구 캐시가 안전하다.
    # (^~ 는 아래 정규식 location 보다 우선하므로 이 블록이 먼저 매칭된다.)
    location ^~ ${BASE_PATH}assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # public/ 자산(models·maps·scenes·images·icons·drawings)은 파일명에 해시가
    # 없다. 대신 프론트가 URL 에 `?v=<내용해시>` 를 붙인다(vite-plugin-asset-hash).
    #
    # 그래서 캐시 정책을 쿼리 유무로 나눈다:
    #   - ?v= 가 있으면  → 내용이 바뀌면 URL 이 바뀐다 → immutable 안전.
    #                      재검증 요청조차 안 가므로 25MB GLB 재방문이 즉시 뜬다.
    #   - ?v= 가 없으면  → URL 이 고정이다 → 반드시 재검증(no-cache).
    #                      직접 입력한 주소나 매니페스트에 없는 파일이 여기 온다.
    #
    # $arg_v 는 쿼리스트링의 v 파라미터다. 이 분기가 없으면 둘 중 하나를 잃는다 —
    # 전부 immutable 로 하면 해시 없는 요청이 옛 파일에 영구히 고정되고,
    # 전부 no-cache 로 하면 해시를 붙인 의미(재검증 왕복 제거)가 사라진다.
    # wasm: KTX2 트랜스코더(public/basis/r<REVISION>/) — 확장자 목록에 없으면
    # SPA 폴백 location 으로 떨어져 Cache-Control 이 아예 안 나가고, 브라우저
    # 휴리스틱 캐시가 임의 기간 옛 wasm 을 내주게 된다(js 트랜스코더와 버전
    # 불일치 → KTX2 디코드 실패). 경로에 three REVISION 이 들어가 갱신 시
    # URL 이 바뀌므로 ?v= 없이 no-cache 재검증이면 충분하다.
    location ~* ^${BASE_PATH}.+\.(?:js|css|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|gif|webp|avif|glb|gltf|json|exr|hdr|bin|ktx2|wasm)$ {
        # expires 는 Cache-Control 을 스스로 쓰므로 반드시 꺼야 한다.
        # 켜 두면 아래 add_header 와 함께 Cache-Control 이 두 번 나가고,
        # 브라우저는 둘 중 보수적인 쪽을 고르지 않는다(구현에 따라 다르다).
        expires off;
        add_header Cache-Control $asset_cache_control always;
        access_log off;
        try_files $uri =404;
    }

    # SPA entry: BASE_PATH 와 그 아래 클라이언트 라우트 → index.html
    location ${BASE_PATH} {
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }

    # BASE_PATH 에서 끝 슬래시를 뺀 주소 → 정식 형태
    location = ${BASE_PATH_NOSLASH} {
        return 302 ${BASE_PATH};
    }

    # indoor 주소(VITE_INDOOR_BASE_URL)는 BASE_PATH 밖일 수 있다 (/crane_rnd/indoor/dev/ vs /crane_rnd/dev/).
    # 번들은 하나라 같은 index.html 을 내면 앱이 주소를 보고 범위를 정한다 (@crane/core resolveAppScope).
    # 에셋은 indoor 화면에서도 BASE_PATH 접두어로 요청하므로 여기서는 HTML 폴백만 맡는다.
    location / {
        try_files $uri ${BASE_PATH}index.html;
    }
}
