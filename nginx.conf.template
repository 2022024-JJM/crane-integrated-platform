# nginx 공식 이미지의 envsubst 가 컨테이너 시작 시 이 파일을 읽어
# ${VAR} 들을 환경변수로 치환한 뒤 /etc/nginx/conf.d/default.conf 로 출력한다.
# 따라서 운영 환경에서 IP/PORT 변경은 .env 만 수정 후 컨테이너 재시작이면 충분하다.

# public/ 자산의 캐시 정책을 URL 의 `?v=` 유무로 가른다.
#
#   ?v=<내용해시> 가 있으면 → 내용이 바뀌면 URL 이 바뀐다 → immutable 안전.
#                             재검증 왕복조차 없으므로 25MB GLB 재방문이 즉시 뜬다.
#   ?v= 가 없으면          → URL 이 고정이다 → 반드시 매번 재검증(no-cache).
#                             직접 친 주소나 매니페스트에 없는 파일이 여기 온다.
#
# location 안의 `if` 로는 이걸 못 한다 — if 안의 add_header 는 바깥 것을
# 대체하지 않고 헤더를 하나 더 붙이기 때문이다. map 은 변수 하나로 값이
# 정해지므로 Cache-Control 이 정확히 한 번만 나간다.
map $arg_v $asset_cache_control {
    ""      "public, no-cache";
    default "public, max-age=31536000, immutable";
}

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    server_tokens off;

    # Security headers
    add_header X-Frame-Options        "SAMEORIGIN"                   always;
    add_header X-Content-Type-Options "nosniff"                      always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/x-javascript
        application/json
        application/xml
        image/svg+xml
        font/woff
        font/woff2
        model/gltf-binary
        model/gltf+json
        application/octet-stream;

    # Health check endpoint
    location = /healthz {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    # API proxy → backend server
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 앞단이 rewrite 없이 그대로 /crane_rnd/api/* 로 전달한 경우에도 안전하게 처리
    location /crane_rnd/api/ {
        rewrite ^/crane_rnd/api/(.*)$ /api/$1 break;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket proxy → backend server
    location /ws/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 rewrite 없이 그대로 /crane_rnd/ws/* 로 전달한 경우에도 안전하게 처리
    location /crane_rnd/ws/ {
        rewrite ^/crane_rnd/ws/(.*)$ /ws/$1 break;
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # LiDAR WebSocket proxy → 별도 LiDAR 서버
    # 프론트는 동일 origin 의 /lidar 또는 /crane_rnd/lidar 로 ws 연결한다.
    # LiDAR 서버는 루트(/)에서 ws 핸드셰이크를 받으므로 / 로만 프록시한다.
    # 슬래시 유무 모두 받아야 하므로 정확 매칭(=) 과 prefix 매칭을 모두 둔다.
    location = /lidar {
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /lidar/ {
        rewrite ^/lidar/(.*)$ /$1 break;
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 그대로 /crane_rnd/lidar(/) 로 전달한 경우 호환
    location = /crane_rnd/lidar {
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /crane_rnd/lidar/ {
        rewrite ^/crane_rnd/lidar/(.*)$ /$1 break;
        proxy_pass http://${LIDAR_HOST}:${LIDAR_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Cabin Monitoring Foxglove bridge WebSocket proxy → 별도 브리지 서버
    # 프론트는 동일 origin 의 /cabin-bridge 또는 /crane_rnd/cabin-bridge 로 ws 연결한다.
    # 브리지 서버는 루트(/)에서 ws 핸드셰이크를 받으므로 / 로만 프록시한다.
    location = /cabin-bridge {
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /cabin-bridge/ {
        rewrite ^/cabin-bridge/(.*)$ /$1 break;
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # 앞단이 그대로 /crane_rnd/cabin-bridge(/) 로 전달한 경우 호환
    location = /crane_rnd/cabin-bridge {
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }
    location /crane_rnd/cabin-bridge/ {
        rewrite ^/crane_rnd/cabin-bridge/(.*)$ /$1 break;
        proxy_pass http://${CABIN_HOST}:${CABIN_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    # Root hit → redirect into the SPA base path
    location = / {
        return 302 /crane_rnd/;
    }

    # index.html — never cache
    location = /crane_rnd/index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        expires 0;
        try_files $uri =404;
    }

    # 빌드 산출물(dist/assets/)만 immutable. vite 가 내용 해시를 파일명에 넣으므로
    # 내용이 바뀌면 URL 도 바뀐다 → 영구 캐시가 안전하다.
    # (^~ 는 아래 정규식 location 보다 우선하므로 이 블록이 먼저 매칭된다.)
    location ^~ /crane_rnd/assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # public/ 자산(models·maps·scenes·images·icons·drawings)은 파일명에 해시가
    # 없다. 대신 프론트가 URL 에 `?v=<내용해시>` 를 붙인다(vite-plugin-asset-hash).
    #
    # 그래서 캐시 정책을 쿼리 유무로 나눈다:
    #   - ?v= 가 있으면  → 내용이 바뀌면 URL 이 바뀐다 → immutable 안전.
    #                      재검증 요청조차 안 가므로 25MB GLB 재방문이 즉시 뜬다.
    #   - ?v= 가 없으면  → URL 이 고정이다 → 반드시 재검증(no-cache).
    #                      직접 입력한 주소나 매니페스트에 없는 파일이 여기 온다.
    #
    # $arg_v 는 쿼리스트링의 v 파라미터다. 이 분기가 없으면 둘 중 하나를 잃는다 —
    # 전부 immutable 로 하면 해시 없는 요청이 옛 파일에 영구히 고정되고,
    # 전부 no-cache 로 하면 해시를 붙인 의미(재검증 왕복 제거)가 사라진다.
    location ~* ^/crane_rnd/.+\.(?:js|css|woff2?|ttf|eot|svg|ico|png|jpg|jpeg|gif|webp|avif|glb|gltf|json|exr|hdr|bin|ktx2)$ {
        # expires 는 Cache-Control 을 스스로 쓰므로 반드시 꺼야 한다.
        # 켜 두면 아래 add_header 와 함께 Cache-Control 이 두 번 나가고,
        # 브라우저는 둘 중 보수적인 쪽을 고르지 않는다(구현에 따라 다르다).
        expires off;
        add_header Cache-Control $asset_cache_control always;
        access_log off;
        try_files $uri =404;
    }

    # SPA entry: /crane_rnd and any deeper client-side route → serve index.html
    location /crane_rnd/ {
        try_files $uri $uri/ /crane_rnd/index.html;
    }

    # "/crane_rnd" (no trailing slash) → canonical form
    location = /crane_rnd {
        return 302 /crane_rnd/;
    }
}
