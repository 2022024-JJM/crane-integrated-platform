# dev 환경 값. 저장소 루트에서:
#   set -a; . deploy/env/dev.env; set +a
#   IMAGE_TAG=dev-<커밋7자리> docker compose -p crane-shell-dev build
#   IMAGE_TAG=dev-<커밋7자리> docker compose -p crane-shell-dev up -d --no-build
# 백엔드 · LiDAR 주소는 지금처럼 루트 .env 에서 읽는다.

# 빌드 때 화면 코드에 들어가는 값 (바꾸면 다시 빌드)
DEPLOY_ENV=dev
BASE_PATH=/crane_rnd/dev/
INDOOR_PATH=/crane_rnd/indoor/dev/

# 컨테이너 실행 값
SHELL_PORT=3362
CONTAINER_SUFFIX=-dev

# 지도 키 — 지금은 이 파일에 둔다 (나중에 GitHub Secret 으로 이동).
# 주석을 풀고 값을 넣는다. 주석인 동안은 루트 .env 의 값이 쓰인다
# (빈 값으로 export 하면 루트 .env 의 키를 덮어쓰므로 빈 줄을 두지 않는다).
# 이 파일은 커밋되므로 Google Cloud 에서 HTTP referrer 제한을 꼭 건다.
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_MAP_ID=
