# =============================================================================
# 운영 서버용 .env 템플릿
#
# 사용법:
#   1) 이 파일을 운영 서버의 docker-compose.yml 과 같은 디렉토리에
#      `.env` 라는 이름으로 복사한다.
#   2) 아래 값들을 운영 환경에 맞게 수정한다.
#   3) `docker compose up -d` 로 기동.
#   4) IP 변경이 필요하면 이 .env 만 수정 후 `docker compose up -d` 로 재시작.
#      (이미지 재빌드 불필요)
# =============================================================================

# 백엔드 서버 (HTTP API + WebSocket)
# nginx 가 /api, /ws 요청을 이 주소로 프록시한다.
BACKEND_HOST=192.168.135.199
BACKEND_PORT=33500

# LiDAR 서버 (LiDAR Edge Node Bridge Server, WebSocket /pointcloud)
# nginx 가 /lidar/* 를 path-rewrite 해서 이 주소로 프록시한다.
LIDAR_HOST=192.168.135.199
LIDAR_PORT=8765

# 캐빈 모니터링 브리지 서버 (Foxglove WebSocket bridge)
# nginx 가 /cabin-bridge/* 를 이 주소로 프록시한다.
# 미설정 시 127.0.0.1:8765 기본값 (캐빈 모니터링 연결만 실패, 나머지 정상)
CABIN_HOST=10.65.195.162
CABIN_PORT=8765

# 컨테이너 외부 노출 포트 (호스트 → 컨테이너)
# 기본 33600. 변경 필요 시 수정.
SHELL_PORT=33600

# =============================================================================
# 아래 VITE_* 는 운영 서버 .env 에 둘 필요 없음 (빌드 머신에만 필요).
# Vite 가 빌드 시점에 번들로 인라인하므로 docker build 단계에서 ARG 로 주입된다.
# 운영 서버는 이미 빌드된 이미지를 받아서 nginx 만 띄우므로 이 값들은 불필요.
#
# 빌드 머신 사용법:
#   - 같은 디렉토리의 .env (또는 셸 환경) 에 VITE_GOOGLE_MAPS_* 가 정의돼 있으면
#     docker compose build 가 자동으로 Dockerfile ARG 로 전달한다.
#   - 또는 docker build --build-arg VITE_GOOGLE_MAPS_API_KEY=... 으로 직접 주입.
# =============================================================================

# Google Maps JavaScript API key (모니터링 → 지도 페이지)
# Google Cloud Console에서 발급받고 HTTP referrer 제한을 반드시 적용한다.
# 클라이언트 번들에 박혀 브라우저로 노출되므로 referrer 제한이 보안의 마지노선.
# VITE_GOOGLE_MAPS_API_KEY=

# (선택) Vector map ID. AdvancedMarker vector 렌더링.
# VITE_GOOGLE_MAPS_MAP_ID=
