# =============================================================================
# HTTP API
# =============================================================================

# HTTP API 서버 베이스 URL
# 미설정 시: window.location.origin/api 로 자동 결정 (개발 시 dev proxy 사용)
# VITE_API_BASE_URL=http://192.168.0.1:33007/api

# API 요청 타임아웃 (ms)
# VITE_API_TIMEOUT_MS=10000

# =============================================================================
# WebSocket
# =============================================================================

# WebSocket 서버 베이스 URL
# 미설정 시: ws://window.location.origin/ws 로 자동 결정 (개발 시 dev proxy 사용)
# VITE_WS_BASE_URL=ws://192.168.0.1:33007/ws

# WebSocket 재연결 간격 (ms)
# VITE_WS_RECONNECT_INTERVAL_MS=3000

# WebSocket 최대 재연결 시도 횟수
# VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# LiDAR 전용 WebSocket URL (독립 서버)
# VITE_LIDAR_WS_URL=ws://192.168.122.140:9002

# =============================================================================
# 개발 서버 프록시 (vite dev server 전용)
# =============================================================================

# HTTP 프록시 대상 서버
# VITE_DEV_PROXY_TARGET_HTTP=http://192.168.135.199:33007

# WebSocket 프록시 대상 서버
# VITE_DEV_PROXY_TARGET_WS=ws://192.168.135.199:33007
