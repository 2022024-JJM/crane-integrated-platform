# =============================================================================
# 이 파일은 "프론트엔드 빌드 / 개발 서버" 가 사용하는 환경변수 예시이다.
# 운영(Docker) 의 백엔드/LiDAR IP 는 여기서 관리하지 않는다.
# 운영 IP 는 docker-compose.yml 옆의 .env 파일(BACKEND_HOST/PORT, LIDAR_HOST/PORT)
# 에서 관리되며, nginx envsubst 가 런타임에 주입한다.
# =============================================================================

# =============================================================================
# HTTP API
# =============================================================================

# HTTP API 서버 베이스 URL
# 미설정 시: window.location.origin/api 로 자동 결정 (운영 nginx /api proxy 로 흐름)
# VITE_API_BASE_URL=

# API 요청 타임아웃 (ms)
# VITE_API_TIMEOUT_MS=10000

# =============================================================================
# WebSocket
# =============================================================================

# WebSocket 서버 베이스 URL
# 미설정 시: ws://window.location.origin/ws 로 자동 결정 (운영 nginx /ws proxy 로 흐름)
# VITE_WS_BASE_URL=

# WebSocket 재연결 간격 (ms)
# VITE_WS_RECONNECT_INTERVAL_MS=3000

# WebSocket 최대 재연결 시도 횟수
# VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# =============================================================================
# 개발 서버 프록시 (vite dev server 전용)
# - 로컬에서 `pnpm dev` 로 실행할 때만 사용된다.
# - 운영 빌드/Docker 와 무관하다.
# =============================================================================

# 백엔드 HTTP 프록시 대상
# VITE_DEV_PROXY_TARGET_HTTP=http://192.168.135.199:33500

# 백엔드 WebSocket 프록시 대상
# VITE_DEV_PROXY_TARGET_WS=ws://192.168.135.199:33500

# LiDAR WebSocket 프록시 대상 (별도 서버)
# VITE_DEV_PROXY_TARGET_LIDAR=ws://192.168.122.140:9002

# Cabin Monitoring Foxglove bridge URL
# 웹 실행 PC와 Foxglove 송신 PC가 다르면 송신 PC IP로 지정한다.
# VITE_DEV_PROXY_TARGET_CABIN=ws://10.65.195.162:8765
# VITE_CABIN_BRIDGE_URL=/crane_rnd/cabin-bridge/

# =============================================================================
# Google Maps (모니터링 → 지도 페이지)
# =============================================================================

# Google Maps JavaScript API key.
# Google Cloud Console에서 발급받고, HTTP referrer 제한을 걸어 사용한다.
# 미설정 시 /monitoring/map 페이지가 안내 박스를 표시한다.
# VITE_GOOGLE_MAPS_API_KEY=

# (선택) Vector map 사용을 위한 Map ID. 설정하면 AdvancedMarker가 vector 모드로 렌더된다.
# VITE_GOOGLE_MAPS_MAP_ID=
